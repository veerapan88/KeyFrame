# Copy this file to .env and fill in real values. Never commit .env.

# Airtable — Personal Access Token from https://airtable.com/create/tokens
# Scopes needed: data.records:read, data.records:write, schema.bases:write
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Stripe — test-mode secret key (starts with sk_test_). Leave blank until
# you're ready to test real refund calls; the app runs fine without it,
# the refund-execution button just stays disabled.
STRIPE_SECRET_KEY=

# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string
